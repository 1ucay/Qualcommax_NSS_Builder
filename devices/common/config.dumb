## "dumb" flavour fragment - applied on top of devices/common/config.
## Keeps only luci-app-filemanager, dawn/luci-app-dawn, ttyd/luci-app-ttyd
## from the extras layer; disables everything else added there.
# CONFIG_PACKAGE_wireguard-tools is not set
# CONFIG_PACKAGE_kmod-wireguard is not set
# CONFIG_PACKAGE_luci-proto-wireguard is not set
# CONFIG_PACKAGE_adblock-fast is not set
# CONFIG_PACKAGE_luci-app-adblock-fast is not set
# CONFIG_PACKAGE_https-dns-proxy is not set
# CONFIG_PACKAGE_luci-app-https-dns-proxy is not set
# CONFIG_PACKAGE_opennds is not set
